
Sub Import_Data_From_Book_B()

    Dim wbA As Workbook
    Dim wbB As Workbook
    Dim wsA As Worksheet
    Dim wsB As Worksheet
    Dim filePath As Variant
    Dim i As Long
    Dim copiedCount As Long
    Dim skippedCount As Long

    ' A 엑셀: 매크로 버튼이 있는 파일
    Set wbA = ThisWorkbook

    ' B 엑셀 파일 선택 창 열기
    filePath = Application.GetOpenFilename( _
        FileFilter:="Excel 파일 (*.xlsx;*.xlsm;*.xls),*.xlsx;*.xlsm;*.xls", _
        Title:="데이터를 가져올 B 엑셀 파일을 선택하세요")

    ' 파일 선택 취소 시 종료
    If VarType(filePath) = vbBoolean Then
        If filePath = False Then Exit Sub
    End If

    On Error GoTo ErrorHandler

    Application.ScreenUpdating = False

    ' B 엑셀 열기
    Set wbB = Workbooks.Open(Filename:=CStr(filePath))

    ' A 엑셀의 8번째 시트부터 마지막 시트까지 확인
    For i = 8 To wbA.Worksheets.Count

        Set wsA = wbA.Worksheets(i)
        Set wsB = Nothing

        ' B 엑셀에서 A 시트와 이름이 같은 시트 찾기
        On Error Resume Next
        Set wsB = wbB.Worksheets(wsA.Name)
        On Error GoTo ErrorHandler

        If Not wsB Is Nothing Then

            ' 시트명이 일치하면 B의 Q열 값을 A의 S열에 덮어쓰기
            wsA.Range("S33:S104").Value = _
                wsB.Range("Q33:Q104").Value

            copiedCount = copiedCount + 1

        Else

            ' 일치하는 시트가 없으면 아무것도 변경하지 않음
            skippedCount = skippedCount + 1

        End If

    Next i

    Application.ScreenUpdating = True

    MsgBox "작업이 완료되었습니다." & vbCrLf & vbCrLf & _
           "복사 완료 시트: " & copiedCount & "개" & vbCrLf & _
           "건너뛴 시트: " & skippedCount & "개" & vbCrLf & vbCrLf & _
           "A 엑셀과 B 엑셀은 저장하거나 닫지 않았습니다.", _
           vbInformation, "작업 완료"

    Exit Sub

ErrorHandler:

    Application.ScreenUpdating = True

    MsgBox "오류가 발생했습니다." & vbCrLf & _
           "내용: " & Err.Description, _
           vbExclamation, "매크로 오류"

End Sub
